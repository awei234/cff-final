{
  "version": 1,
  "scenario_id": "ucr-core-v1",
  "scenarios": [
    {
      "scenario_id": "ucr-core-v1",
      "operation_id": "run_success",
      "kind": "command",
      "action": "execute",
      "target": "checksum script",
      "argv": ["{python}", "-c", "import hashlib; print(hashlib.sha256(b'ucr-control').hexdigest())"]
    },
    {
      "scenario_id": "ucr-core-v1",
      "operation_id": "run_failed",
      "kind": "command",
      "action": "execute",
      "target": "failing experiment script",
      "argv": ["{python}", "-c", "import sys; print('experiment unavailable', file=sys.stderr); sys.exit(7)"]
    },
    {
      "scenario_id": "ucr-core-v1",
      "operation_id": "run_denied",
      "kind": "denied",
      "action": "execute",
      "target": "restricted evaluator",
      "detail": "execution prohibited by scenario policy"
    },
    {
      "scenario_id": "ucr-core-v1",
      "operation_id": "inspect_existing",
      "kind": "read_file",
      "target": "fixtures/observations.json"
    },
    {
      "scenario_id": "ucr-core-v1",
      "operation_id": "inspect_missing",
      "kind": "read_file",
      "target": "fixtures/missing-results.json"
    },
    {
      "scenario_id": "ucr-core-v1",
      "operation_id": "query_available",
      "kind": "query_fixture",
      "target": "fixtures/source-record.json"
    },
    {
      "scenario_id": "ucr-core-v1",
      "operation_id": "query_unavailable",
      "kind": "query_fixture",
      "target": "fixtures/unavailable-source.json"
    },
    {
      "scenario_id": "ucr-core-v1",
      "operation_id": "validate_success",
      "kind": "command",
      "action": "validate",
      "target": "control artifact",
      "argv": ["{python}", "-c", "print('validation passed')"]
    },
    {
      "scenario_id": "ucr-core-v1",
      "operation_id": "validate_failed",
      "kind": "command",
      "action": "validate",
      "target": "corrupt artifact",
      "argv": ["{python}", "-c", "import sys; print('validation failed', file=sys.stderr); sys.exit(3)"]
    }
  ]
}
