      "title": "Multi-Agent System Based on Bi-Level FBS Self-Closed-Loop Co-Evolution Framework",
      "authors": [
        "Cao",
        "Ming",
        "Allen",
        "Mistree"
      ],
      "published_at": "2025-8-17",
